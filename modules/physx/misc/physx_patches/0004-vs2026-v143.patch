+# godot_physx: a machine with Visual Studio 2026 and no Visual Studio 2022 (not even its Build Tools) builds the vc17
+# presets with the VS 2026 generator and VS 2022's v143 toolset (the "MSVC v143" component of VS 2026), so the SDK
+# is the same as from VS 2022: vc143 libraries, and CUDA 12.x still works. None when VS 2022 is installed.
+_vs2026Fallback = []
+
+
+def vs2026WithV143():
+    if not _vs2026Fallback:
+        found = {}
+        vswhere = os.path.join(os.environ.get('PM_vswhere_PATH', ''), 'VsWhere.exe')
+        for name, versions in (('2022', '[17.0,18.0)'), ('2026', '[18.0,19.0)')):
+            path = ''
+            if os.path.isfile(vswhere):
+                path = subprocess.run([vswhere, '-products', '*', '-version', versions, '-latest', '-property', 'installationPath'], capture_output=True, text=True).stdout.strip()
+            found[name] = path != ''
+        use = not found['2022'] and found['2026']
+        if use:
+            print('Visual Studio 2022 not found, Visual Studio 2026 is: using its generator with the v143 toolset')
+        _vs2026Fallback.append(use)
+    return _vs2026Fallback[0]
+
