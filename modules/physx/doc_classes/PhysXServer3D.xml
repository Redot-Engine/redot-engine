		<method name="articulation_set_drive">
			<return type="void" />
			<param index="0" name="articulation" type="RID" />
			<param index="1" name="link_index" type="int" />
			<param index="2" name="axis" type="int" />
			<param index="3" name="stiffness" type="float" />
			<param index="4" name="damping" type="float" />
			<param index="5" name="drive_target" type="float" />
			<param index="6" name="drive_velocity" type="float" />
			<param index="7" name="drive_type" type="int" />
			<description>
				Unlocks [param axis] on the link's inbound joint and configures a PD drive toward [param drive_target] at [param drive_velocity]. Axes: 0 TWIST, 1 SWING1, 2 SWING2, 3 X, 4 Y, 5 Z. [param drive_type]: 0 FORCE, 1 ACCELERATION.
			</description>
		</method>
		<method name="articulation_set_fix_base">
			<return type="void" />
			<param index="0" name="articulation" type="RID" />
			<param index="1" name="fix" type="bool" />
			<description>
				Fixes the base link in place (robot/anchored chains). Set before [method articulation_set_space].
			</description>
		</method>
		<method name="articulation_set_limit">
			<return type="void" />
			<param index="0" name="articulation" type="RID" />
			<param index="1" name="link_index" type="int" />
			<param index="2" name="axis" type="int" />
			<param index="3" name="low" type="float" />
			<param index="4" name="high" type="float" />
			<description>
				Unlocks [param axis] and clamps it to [code][low, high][/code] with a joint limit.
			</description>
		</method>
		<method name="articulation_set_link_collision_layer">
			<return type="void" />
			<param index="0" name="articulation" type="RID" />
			<param index="1" name="link_index" type="int" />
			<param index="2" name="layer" type="int" />
			<description>
				Sets the link shape's collision layer (Redot "what I am" bits, filter word0).
			</description>
		</method>
		<method name="articulation_set_link_collision_mask">
			<return type="void" />
			<param index="0" name="articulation" type="RID" />
			<param index="1" name="link_index" type="int" />
			<param index="2" name="mask" type="int" />
			<description>
				Sets the link shape's collision mask (Redot "what I collide with" bits, filter word1).
			</description>
		</method>
		<method name="articulation_set_link_shape">
			<return type="void" />
			<param index="0" name="articulation" type="RID" />
			<param index="1" name="link_index" type="int" />
			<param index="2" name="shape" type="RID" />
			<param index="3" name="transform" type="Transform3D" />
			<description>
				Replaces the link's collision shape with a per-link instance of the shared shape [param shape] (created by the shape_create methods), placed at [param transform]. Convex polygon shapes preserve mirroring; concave shapes degrade to query-only on links (they simulate — REG-0014 semantics). Mass properties are recomputed at the link's stored density.
			</description>
		</method>
		<method name="articulation_set_space">
			<return type="void" />
			<param index="0" name="articulation" type="RID" />
			<param index="1" name="space" type="RID" />
			<description>
				Attaches the articulation to a physics space (or detaches it with an invalid RID). Add all links before calling this; [code]PxArticulationLink[/code]s cannot be created while the articulation is in a scene.
			</description>
		</method>
